# ---------------------------------------------------------------------------
# Tangent environment variables
# Copy to .env.local and fill in what you need. Everything is optional for
# local development: without Supabase, Tangent runs a clearly labelled demo
# workspace; without OpenAI, AI features show a "not configured" state.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true to run the labelled demo workspace even when Supabase is configured.
NEXT_PUBLIC_TANGENT_FORCE_DEMO=false

# Supabase (auth, Postgres with RLS, storage). Enables "live" mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: only for trusted background jobs (sync, publishing workers). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# AI — set one or both. With both, Tangent fails over automatically (no credits,
# invalid key, rate limits, outages) in the order below.
AI_PROVIDER_ORDER=openai,anthropic
OPENAI_API_KEY=
# OpenAI model routing: "fast" for planning/copy, "reasoning" for strategy.
AI_MODEL_FAST=gpt-5-mini
AI_MODEL_REASONING=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_REASONING=claude-sonnet-5-5
# Max agent steps the orchestrator may run per request (1-10).
AI_MAX_STEPS_PER_RUN=4
# Image generation for Creative Studio: none | openai (needs OPENAI_API_KEY with credits).
IMAGE_PROVIDER=none
IMAGE_MODEL=gpt-image-2.6-sunburst
VIDEO_PROVIDER=none

# 32-byte base64 key for encrypting OAuth tokens at rest (openssl rand -base64 32)
INTEGRATION_ENCRYPTION_KEY=

# Meta (Instagram, Facebook Pages, Meta Ads)
META_APP_ID=
META_APP_SECRET=

# Google (YouTube, Google Ads, Search Console, Google sign-in is configured in Supabase)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Future social platforms
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Automation
N8N_BASE_URL=
N8N_API_KEY=

# Billing (Tangent subscriptions only — never ad spend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Background jobs (BullMQ) and monitoring
REDIS_URL=
SENTRY_DSN=
